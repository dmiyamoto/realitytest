# Copy to .env.local (gitignored) and fill in. Never commit real values.
#   cp env.example .env.local

# --- Meta Model API (SAM 3.1) ---
# Required for LIVE inference. Without it, only recorded API fixtures can be shown.
MODEL_API_KEY=
# META_API_BASE_URL=https://api.meta.ai/v1

# --- Billing (optional, OFF by default) ---
# Set to true to enable the /pricing page, Stripe Checkout and the webhook.
# When false, live evaluations are free, limited by the caps below.
BILLING_ENABLED=false

# --- Stripe (only when BILLING_ENABLED=true; TEST MODE ONLY: sk_test_..., whsec_...) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price for "20 evaluation credits — $9" created in the Stripe test dashboard
STRIPE_PRICE_ID_PACK20=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secret used to sign the HttpOnly guest-session cookie (long random string)
SESSION_SECRET=
DATABASE_URL=file:../data/realitytest.db
# Where uploaded videos are stored (persistent volume in Docker)
STORAGE_DIR=./storage

# --- Limits ---
# Free live SAM evaluations per guest session
# (default: 20 with billing off, 2 with billing on before credits are required)
# FREE_EVALUATIONS_PER_SESSION=20
# Live SAM evaluations per day across the whole server (default 100)
# MAX_LIVE_EVALUATIONS_PER_DAY=100
# Fraction of frames in which the object must be tracked (default 0.6)
EVAL_COVERAGE_THRESHOLD=0.6
